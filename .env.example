# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=phi4-mini
LLM_API_BASE=http://localhost:11434

# LangSmith Tracing Configuration
# Enable/disable LangSmith tracing for AI agent execution observability
# Set to "true" to enable tracing, "false" or leave unset to disable
LANGSMITH_TRACING=false

# LangSmith project name for organizing traces
# Default: Enterprise-AI-TestAutomation
LANGSMITH_PROJECT=Enterprise-AI-TestAutomation

# LangSmith API key for authentication
# Required when LANGSMITH_TRACING=true
# WARNING: Never hardcode API keys in source code - use environment variables only
LANGSMITH_API_KEY=your_api_key_here

# LangSmith API endpoint URL
# Default: https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# RAG (Retrieval Augmented Generation) Configuration
# Enable/disable RAG knowledge base for context-aware requirement processing
RAG_ENABLED=false

# Vector database provider (chroma or ragflow)
RAG_VECTOR_DB_PROVIDER=ragflow

# RAGFlow API Configuration (required if RAG_ENABLED=true and provider=ragflow)
# RAGFlow API base URL
RAGFLOW_API_BASE=http://localhost:9380

# RAGFlow API key for authentication
RAGFLOW_API_KEY=your_ragflow_api_key_here

# RAGFlow dataset ID for document storage and retrieval
RAGFLOW_DATASET_ID=your_dataset_id_here
