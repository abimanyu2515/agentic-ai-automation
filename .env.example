# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=phi4-mini
LLM_API_BASE=http://localhost:11434

# LangSmith Tracing Configuration
# Enable/disable LangSmith tracing for AI agent execution observability
# Set to "true" to enable tracing, "false" or leave unset to disable
LANGSMITH_TRACING=false

# LangSmith project name for organizing traces
# Default: Enterprise-AI-TestAutomation
LANGSMITH_PROJECT=Enterprise-AI-TestAutomation

# LangSmith API key for authentication
# Required when LANGSMITH_TRACING=true
# WARNING: Never hardcode API keys in source code - use environment variables only
LANGSMITH_API_KEY=your_api_key_here

# LangSmith API endpoint URL
# Default: https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# RAG (Retrieval Augmented Generation) Configuration
# Enable/disable RAG knowledge base for context-aware requirement processing
RAG_ENABLED=false

# Vector database provider (chroma or ragflow)
RAG_VECTOR_DB_PROVIDER=ragflow

# RAGFlow API Configuration (required if RAG_ENABLED=true and provider=ragflow)
# RAGFlow API base URL
RAGFLOW_API_BASE=http://localhost:9380

# RAGFlow API key for authentication
RAGFLOW_API_KEY=your_ragflow_api_key_here

# There is no global dataset: each project gets its own RAGFlow dataset,
# created the first time something is indexed for it (spec 0006).

# Per project knowledge base (spec 0006)
# Where uploaded files are saved: <RAG_STORAGE_ROOT>/<project_id>/documents/<document_id>/<name>
RAG_STORAGE_ROOT=data/projects
# Largest upload in MB, and the allowed file extensions
RAG_UPLOAD_MAX_MB=20
RAG_UPLOAD_TYPES=pdf,docx,txt,md,csv,xlsx
# How often to check RAGFlow parsing, and when to give up (seconds)
RAG_PARSE_POLL_SECONDS=5
RAG_PARSE_TIMEOUT_SECONDS=600
# Waits in seconds before each retry when a RAGFlow call fails
RAG_INDEX_RETRY_DELAYS=10,60,300
# Minutes between replays of RAGFlow deletes that have not succeeded yet
RAG_DELETE_RESWEEP_MINUTES=30

# Graded retrieval stage in the workflow (spec 0006). It searches the project's
# knowledge before the scenario, test case, requirement, and analysis agents.
# Keep it off until the retrieval eval shows acceptable recall.
RAG_WORKFLOW_RETRIEVAL_ENABLED=false
# Chunks kept per stage, search attempts (the first plus rewrites), and the
# relevant chunks wanted before the stage stops rewriting
RAG_TOP_K=8
RAG_MAX_RETRIEVAL_ATTEMPTS=2
RAG_MIN_RELEVANT_CHUNKS=2

# Retrieval LLM role: grades chunks and rewrites weak queries.
# Every unset value falls back to the resolved ANALYSIS_LLM_* role.
# RETRIEVAL_LLM_PROVIDER=
# RETRIEVAL_LLM_MODEL=
# RETRIEVAL_LLM_API_KEY=
# RETRIEVAL_LLM_API_BASE=
# RETRIEVAL_LLM_MAX_CONCURRENT=2
# RETRIEVAL_LLM_COOLDOWN_SECONDS=30
# RETRIEVAL_LLM_MAX_WAIT_SECONDS=20

# ---------------------------------------------------------------- webhook secrets (spec 0009)
# Machine callers prove who they are with these. An empty value closes their
# routes with 503, never opens them. Generate each with 32 random bytes, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Playwright workspace: run results, project credentials, script freeze and save.
# Put the same value in backend/playwrightt/.env.local.
WORKSPACE_WEBHOOK_SECRET=
# Jira webhook. Add it to the Jira webhook URL as ?secret=<value>, or send it
# in an X-Webhook-Secret header from a Jira Automation rule.
JIRA_WEBHOOK_SECRET=
