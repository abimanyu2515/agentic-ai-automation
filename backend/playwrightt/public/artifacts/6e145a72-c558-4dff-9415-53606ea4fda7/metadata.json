  "script": "import { test, expect } from '@playwright/test';\n\nconst BASE_URL = process.env.TARGET_URL || 'https://adactinhotelapp.com/';\nconst USERNAME = process.env.TARGET_USERNAME || 'ADACTINFORQA';\nconst PASSWORD = process.env.TARGET_PASSWORD || '3U0515';\n\ntest('Successful login with valid credentials', async ({ page }) => {\n  // Step 1: Navigate to the application base URL\n  console.log('[Timeline] Navigate: to application base URL');\n  await page.goto(BASE_URL);\n\n  // Step 2: Enter username into the Username field\n  console.log('[Timeline] Type: enter username into Username field');\n  await page.locator('input#username').fill(USERNAME);\n\n  // Step 3: Enter password into the Password field\n  console.log('[Timeline] Type: enter password into Password field');\n  await page.locator('input#password').fill(PASSWORD);\n\n  // Step 4: Click the Login button\n  console.log('[Timeline] Click: Login button');\n  await page.locator('input#login').click();\n\n  // Expected result: User is redirected to Search Hotel page and welcome message is displayed\n  await expect(page).toHaveURL(/SearchHotel\\.php/);\n  await expect(page.locator('input#username_show')).toHaveValue('Hello ADACTINFORQA!');\n});",
