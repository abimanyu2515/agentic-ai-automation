  "script": "import { test, expect } from '@playwright/test';\n\nconst BASE_URL = process.env.TARGET_URL || 'https://adactinhotelapp.com/';\nconst USERNAME = process.env.TARGET_USERNAME || 'ADACTINFORQA';\n\ntest('Login with incorrect password', async ({ page }) => {\n  // Navigate to the Adactin Hotel Application\n  await page.goto(BASE_URL, { waitUntil: 'networkidle' });\n  console.log('Navigated to Adactin Hotel Portal');\n\n  // Take a screenshot of the initial state\n  await page.screenshot({ path: '01-initial-state.png' });\n\n  // Perform Login with valid username but incorrect password\n  await page.locator('#username').fill(USERNAME);\n  await page.locator('#password').fill('WrongPassword123');\n  await page.locator('#login').click();\n  console.log('Filled credentials and clicked Login');\n\n  // Wait a moment for the page to respond\n  await page.waitForTimeout(2000);\n\n  // Verify user is still on the login page (not redirected to SearchHotel.php)\n  // The login page is at the root URL, not /index.php\n  await expect(page).toHaveURL(/adactinhotelapp\\.com/);\n  // Also verify we're NOT on the search hotel page\n  await expect(page).not.toHaveURL(/SearchHotel\\.php/);\n  console.log('User remains on login page as expected');\n\n  // Verify login form is still visible (confirming we're on login page)\n  await expect(page.locator('#username')).toBeVisible();\n  await expect(page.locator('#password')).toBeVisible();\n  await expect(page.locator('#login')).toBeVisible();\n  console.log('Login form still visible - confirmed on login page');\n\n  // Take screenshot of error state\n  await page.screenshot({ path: '02-invalid-login-error.png' });\n});",
