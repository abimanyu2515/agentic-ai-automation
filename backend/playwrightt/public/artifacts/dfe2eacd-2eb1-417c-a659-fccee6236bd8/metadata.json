  "script": "import { test, expect } from '@playwright/test';\n\nconst BASE_URL = process.env.TARGET_URL || 'https://adactinhotelapp.com/';\nconst USERNAME = process.env.TARGET_USERNAME || 'ADACTINFORQA';\nconst PASSWORD = process.env.TARGET_PASSWORD || '3U0515';\n\ntest('Valid booking generates order number', async ({ page }) => {\n  // [Timeline] Navigate to base URL\n  console.log('[Timeline] Navigate to base URL');\n  await page.goto(BASE_URL);\n\n  // [Timeline] Log in with valid credentials\n  console.log('[Timeline] Log in with valid credentials');\n  await page.locator('input#username').fill(USERNAME);\n  await page.locator('input#password').fill(PASSWORD);\n  await page.locator('input#login').click();\n  await expect(page).toHaveURL(/SearchHotel\\.php/);\n\n  // [Timeline] Perform hotel search (precondition: user has completed search and selected a hotel)\n  console.log('[Timeline] Perform hotel search');\n  await expect(page.locator('input#username_show')).toHaveValue('Hello ADACTINFORQA!');\n  await page.locator('select#location').selectOption({ label: 'Sydney' });\n  await page.locator('select#hotels').selectOption({ label: 'Hotel Creek' });\n  await page.locator('select#room_type').selectOption({ label: 'Standard' });\n  await page.locator('select#room_nos').selectOption({ label: '1 - One' });\n  await page.locator('input#datepick_in').fill('20/08/2026');\n  await page.locator('input#datepick_out').fill('25/08/2026');\n  await page.locator('select#adult_room').selectOption({ label: '1 - One' });\n  await page.locator('select#child_room').selectOption({ label: '0 - None' });\n  await page.locator('input#Submit').click();\n  await expect(page).toHaveURL(/SelectHotel\\.php/);\n\n  // [Timeline] Select the first hotel (precondition: user selected a hotel)\n  console.log('[Timeline] Select the first hotel');\n  await page.locator('input#radiobutton_0').check();\n  await page.locator('input#continue').click();\n  await expect(page).toHaveURL(/BookHotel\\.php/);\n\n  // Now on BookHotel.php – proceed with given steps\n  // [Timeline] Fill in First Name\n  console.log('[Timeline] Fill in First Name');\n  await page.locator('input#first_name').fill('John');\n  // [Timeline] Fill in Last Name\n  console.log('[Timeline] Fill in Last Name');\n  await page.locator('input#last_name').fill('Doe');\n  // [Timeline] Fill in Billing Address\n  console.log('[Timeline] Fill in Billing Address');\n  await page.locator('textarea#address').fill('123 Test Street, Sydney, NSW');\n  // [Timeline] Select Credit Card Type as VISA\n  console.log('[Timeline] Select Credit Card Type as VISA');\n  await page.locator('select#cc_type').selectOption({ label: 'VISA' });\n  // [Timeline] Fill in Credit Card Number\n  console.log('[Timeline] Fill in Credit Card Number');\n  await page.locator('input#cc_num').fill('1234567890123456');\n  // [Timeline] Select Expiry Month as December\n  console.log('[Timeline] Select Expiry Month as December');\n  await page.locator('select#cc_exp_month').selectOption({ label: 'December' });\n  // [Timeline] Select Expiry Year as 2028\n  console.log('[Timeline] Select Expiry Year as 2028');\n  await page.locator('select#cc_exp_year').selectOption({ label: '2028' });\n  // [Timeline] Fill in CVV Number\n  console.log('[Timeline] Fill in CVV Number');\n  await page.locator('input#cc_cvv').fill('123');\n  // [Timeline] Click Book Now button\n  console.log('[Timeline] Click Book Now button');\n  await page.locator('input#book_now').click();\n\n  // [Timeline] Assert redirection to BookingConfirm.php and numeric order number\n  console.log('[Timeline] Assert redirection to BookingConfirm.php and numeric order number');\n  await expect(page).toHaveURL(/BookingConfirm\\.php/, { timeout: 15000 });\n  const orderNumber = await page.locator('input#order_no').inputValue();\n  expect(orderNumber).toMatch(/^\\d+$/);\n});",
