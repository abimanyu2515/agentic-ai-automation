  "script": "import { test, expect } from '@playwright/test';\n\nconst BASE_URL = process.env.TARGET_URL || 'https://adactinhotelapp.com/';\nconst USERNAME = process.env.TARGET_USERNAME || 'default_username';\nconst PASSWORD = process.env.TARGET_PASSWORD || 'default_password';\n\ntest('Personalised greeting after login', async ({ page }) => {\n  console.log('[Timeline] Navigate to Adactin Hotel login page');\n  await page.goto(BASE_URL);\n\n  console.log('[Timeline] Enter username in the Username field');\n  await page.locator('input#username').fill(USERNAME);\n\n  console.log('[Timeline] Enter password in the Password field');\n  await page.locator('input#password').fill(PASSWORD);\n\n  console.log('[Timeline] Click the Login button');\n  await page.locator('input#login').click();\n\n  // Wait for the welcome message element to be visible after successful login\n  const welcomeInput = page.locator('input#username_show');\n  await expect(welcomeInput).toBeVisible({ timeout: 10000 });\n\n  console.log('[Timeline] Assert welcome message contains the logged-in username');\n  await expect(welcomeInput).toHaveValue(`Hello ${USERNAME}!`);\n});",
