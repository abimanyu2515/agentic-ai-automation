  "script": "import { test, expect } from '@playwright/test';\n\nconst BASE_URL = process.env.TARGET_URL || 'https://adactinhotelapp.com/';\nconst USERNAME = process.env.TARGET_USERNAME || 'ADACTINFORQA';\nconst PASSWORD = process.env.TARGET_PASSWORD || '3U0515';\n\ntest('Search with past check-in date', async ({ page }) => {\n  // Navigate to base URL\n  console.log('[Timeline] Navigate to Adactin Hotel App');\n  await page.goto(BASE_URL);\n\n  // Login\n  console.log('[Timeline] Login: enter username');\n  await page.locator('input#username').fill(USERNAME);\n  console.log('[Timeline] Login: enter password');\n  await page.locator('input#password').fill(PASSWORD);\n  console.log('[Timeline] Login: click Login button');\n  await page.locator('input#login').click();\n\n  // Wait for redirect to Search Hotel page\n  console.log('[Timeline] Wait for redirect to SearchHotel.php');\n  await expect(page).toHaveURL(/SearchHotel\\.php/);\n\n  // Step 1: Clear the Check In Date field\n  console.log('[Timeline] Clear default check-in date');\n  await page.locator('input#datepick_in').fill('');\n\n  // Step 2: Enter a past date\n  console.log('[Timeline] Enter past check-in date: 01/01/2020');\n  await page.locator('input#datepick_in').fill('01/01/2020');\n\n  // Step 3: Fill other mandatory fields\n  console.log('[Timeline] Select Location: Sydney');\n  await page.locator('select#location').selectOption({ label: 'Sydney' });\n\n  console.log('[Timeline] Select Number of Rooms: 1 - One');\n  await page.locator('select#room_nos').selectOption({ label: '1 - One' });\n\n  console.log('[Timeline] Enter Check Out Date: 05/01/2020');\n  await page.locator('input#datepick_out').fill('05/01/2020');\n\n  console.log('[Timeline] Select Adults per Room: 1');\n  await page.locator('select#adult_room').selectOption({ label: '1' });\n\n  // Step 4: Click Search button\n  console.log('[Timeline] Click Search button');\n  await page.locator('input#Submit').click();\n\n  // Assert: The form does not submit and the user remains on the Search Hotel page\n  console.log('[Timeline] Assert that user remains on SearchHotel.php');\n  await expect(page).toHaveURL(/SearchHotel\\.php/);\n  // Also verify that the search form is still present (e.g., location dropdown visible)\n  await expect(page.locator('select#location')).toBeVisible();\n});",
