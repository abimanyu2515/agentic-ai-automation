  "script": "import { test, expect } from '@playwright/test';\n\nconst BASE_URL = process.env.TARGET_URL || 'https://www.saucedemo.com';\nconst USERNAME = process.env.TARGET_USERNAME || 'standard_user';\nconst PASSWORD = process.env.TARGET_PASSWORD || 'secret_sauce';\n\ntest('Navigate and submit valid credentials', async ({ page }) => {\n  // Navigate to the configured target site base URL\n  console.log(\"[Timeline] Navigate: to base URL\");\n  await page.goto(BASE_URL);\n\n  // Enter the valid username into the username field\n  console.log(\"[Timeline] Enter: username into username field\");\n  await page.getByLabel('Username').fill(USERNAME);\n\n  // Enter the valid password into the password field\n  console.log(\"[Timeline] Enter: password into password field\");\n  await page.getByLabel('Password').fill(PASSWORD);\n\n  // Submit the login form\n  console.log(\"[Timeline] Click: login button\");\n  await page.getByRole('button', { name: 'Login' }).click();\n\n  // Wait for the post-login landing to complete (redirect to authenticated page)\n  console.log(\"[Timeline] Wait: for navigation to authenticated home or dashboard page\");\n  await expect(page).not.toHaveURL(BASE_URL, { timeout: 15000 });\n\n  // Assert the application accepted valid credentials and redirected away from the login page\n  console.log(\"[Timeline] Assert: user is on authenticated home or dashboard page\");\n  await expect(page).not.toHaveURL(BASE_URL);\n});",
