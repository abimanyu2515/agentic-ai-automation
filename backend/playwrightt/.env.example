# Copy to .env.local (git ignored) and fill in.

# Same value as WORKSPACE_WEBHOOK_SECRET in the backend .env (spec 0009).
# The workspace sends it on run results, credential reads, and script freeze and save.
WORKSPACE_WEBHOOK_SECRET=

# Where the workspace server routes reach FastAPI. Default: http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
